rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfiles de usuario
    match /users/{userId} {
      // Cada usuario lee su propio perfil, o un entrenador puede leer todos
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'trainer'
      );

      // Al registrarse, se crea con rol "student"
      allow create: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.role == 'student';

      // El usuario puede editar sus datos (excepto su rol).
      // Un entrenador puede cambiar el rol de cualquiera.
      allow update: if request.auth != null && (
        (request.auth.uid == userId && !('role' in request.resource.data.diff(resource.data).affectedKeys())) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'trainer'
      );

      // Un entrenador puede eliminar perfiles de alumnos
      allow delete: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'trainer'
      );
    }

    // Datos de entrenamiento (rutinas, pesos, historial)
    // El propio usuario o su entrenador pueden leer y escribir
    match /users/{userId}/data/{doc} {
      allow read, write: if request.auth != null && (
        request.auth.uid == userId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'trainer'
      );
    }

  }
}
